{
  "schemaVersion": 2,
  "mode": "generic",
  "requirements": {
    "familyABIs": [],
    "minimumEngineVersion": 1
  },
  "id": "org.pixeltje.examples.physics-bounce",
  "name": "Physics Bounce Starter",
  "exposedParameters": [],
  "primaryOutputNodeIDs": [
    "output"
  ],
  "nodes": [
    {
      "executionState": "enabled",
      "id": "start",
      "kind": "control.start",
      "parameters": {},
      "resources": {},
      "title": "Start / Next Frame"
    },
    {
      "executionState": "enabled",
      "id": "shader-text",
      "kind": "primitive.filePath",
      "parameters": {
        "mode": "relative",
        "path": "PhysicsBounceProgram.metal"
      },
      "resources": {},
      "title": "Physics Bounce Metal source"
    },
    {
      "executionState": "enabled",
      "id": "render",
      "kind": "gpu.program",
      "parameters": {
        "framesPerSecond": {
          "$type": "number",
          "value": 60
        },
        "seed": {
          "$type": "integer",
          "value": 1
        }
      },
      "resources": {},
      "title": "One sphere, static floor and box"
    },
    {
      "executionState": "enabled",
      "id": "output",
      "kind": "output.image",
      "parameters": {
        "filenamePrefix": "physics-bounce",
        "format": "png"
      },
      "resources": {},
      "title": "Physics frame"
    },
    {
      "executionState": "enabled",
      "id": "loop",
      "kind": "control.loop",
      "parameters": {
        "autoPause": false,
        "delayMilliseconds": {
          "$type": "integer",
          "value": 0
        },
        "feedback": "none",
        "limitHz": {
          "$type": "integer",
          "value": 60
        },
        "maxCalls": {
          "$type": "integer",
          "value": -1
        },
        "seedStrategy": "fixed"
      },
      "resources": {},
      "title": "Live physics loop \u00b7 60 Hz"
    },
    {
      "executionState": "enabled",
      "id": "primitive-int",
      "kind": "primitive.int",
      "parameters": {
        "value": {
          "$type": "integer",
          "value": 800
        }
      },
      "resources": {},
      "title": "Output width"
    },
    {
      "executionState": "enabled",
      "id": "primitive-int-2",
      "kind": "primitive.int",
      "parameters": {
        "value": {
          "$type": "integer",
          "value": 500
        }
      },
      "resources": {},
      "title": "Output height"
    },
    {
      "executionState": "enabled",
      "id": "program-text",
      "kind": "primitive.string",
      "parameters": {
        "value": "{\"version\":1,\"resources\":[{\"name\":\"game\",\"kind\":\"buffer\",\"bytes\":32},{\"name\":\"display\",\"kind\":\"texture\"}],\"initialize\":[{\"kind\":\"compute\",\"function\":\"initializePhysics\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}}],\"tick\":[{\"kind\":\"compute\",\"function\":\"advancePhysics\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}}],\"present\":[{\"kind\":\"render\",\"vertex\":\"fullscreenVertex\",\"fragment\":\"physicsFragment\",\"target\":\"display\",\"load\":\"clear\",\"vertexCount\":3,\"fragmentBuffers\":{\"1\":\"game\"}}],\"swaps\":[],\"output\":\"display\"}"
      },
      "resources": {},
      "title": "Physics state and GPU passes"
    }
  ],
  "connections": [
    {
      "id": "render.image->output.image",
      "input": {
        "nodeID": "output",
        "port": "image"
      },
      "output": {
        "nodeID": "render",
        "port": "image"
      }
    },
    {
      "id": "primitive-int.value->render.width",
      "input": {
        "nodeID": "render",
        "port": "width"
      },
      "output": {
        "nodeID": "primitive-int",
        "port": "value"
      }
    },
    {
      "id": "primitive-int-2.value->render.height",
      "input": {
        "nodeID": "render",
        "port": "height"
      },
      "output": {
        "nodeID": "primitive-int-2",
        "port": "value"
      }
    },
    {
      "id": "program-text.value->render.program",
      "input": {
        "nodeID": "render",
        "port": "program"
      },
      "output": {
        "nodeID": "program-text",
        "port": "value"
      }
    },
    {
