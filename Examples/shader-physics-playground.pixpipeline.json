{
  "schemaVersion": 2,
  "mode": "generic",
  "requirements": {
    "familyABIs": [],
    "minimumEngineVersion": 1
  },
  "id": "org.pixeltje.examples.physics-playground",
  "name": "Physics Playground",
  "exposedParameters": [],
  "primaryOutputNodeIDs": [
    "output"
  ],
  "nodes": [
    {
      "executionState": "enabled",
      "id": "start",
      "kind": "control.start",
      "parameters": {},
      "resources": {},
      "title": "Start / Next Frame"
    },
    {
      "executionState": "enabled",
      "id": "shader-text",
      "kind": "primitive.filePath",
      "parameters": {
        "mode": "relative",
        "path": "PhysicsPlaygroundProgram.metal"
      },
      "resources": {},
      "title": "Physics Playground Metal source"
    },
    {
      "executionState": "enabled",
      "id": "render",
      "kind": "gpu.program",
      "parameters": {
        "framesPerSecond": {
          "$type": "number",
          "value": 60
        },
        "seed": {
          "$type": "integer",
          "value": 1
        }
      },
      "resources": {},
      "title": "Structures, support and rigid bodies"
    },
    {
      "executionState": "enabled",
      "id": "output",
      "kind": "output.image",
      "parameters": {
        "filenamePrefix": "physics-playground",
        "format": "png"
      },
      "resources": {},
      "title": "Starter game frame"
    },
    {
      "executionState": "enabled",
      "id": "loop",
      "kind": "control.loop",
      "parameters": {
        "autoPause": false,
        "delayMilliseconds": {
          "$type": "integer",
          "value": 0
        },
        "feedback": "none",
        "limitHz": {
          "$type": "integer",
          "value": 60
        },
        "maxCalls": {
          "$type": "integer",
          "value": -1
        },
        "seedStrategy": "fixed"
      },
      "resources": {},
      "title": "Live physics loop · 60 Hz"
    },
    {
      "executionState": "enabled",
      "id": "primitive-int",
      "kind": "primitive.int",
      "parameters": {
        "value": {
          "$type": "integer",
          "value": 960
        }
      },
      "resources": {},
      "title": "Output width"
    },
    {
      "executionState": "enabled",
      "id": "primitive-int-2",
      "kind": "primitive.int",
      "parameters": {
        "value": {
          "$type": "integer",
          "value": 600
        }
      },
      "resources": {},
      "title": "Output height"
    },
    {
      "executionState": "enabled",
      "id": "program-text",
      "kind": "primitive.string",
      "parameters": {
        "value": "{\"version\":1,\"resources\":[{\"name\":\"game\",\"kind\":\"buffer\",\"bytes\":131072},{\"name\":\"display\",\"kind\":\"texture\"}],\"initialize\":[{\"kind\":\"compute\",\"function\":\"initializePlayground\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}},{\"kind\":\"compute\",\"function\":\"linkPlaygroundParts\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}}],\"tick\":[{\"kind\":\"compute\",\"function\":\"advancePlayer\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}},{\"kind\":\"compute\",\"function\":\"restartPlayground\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}},{\"kind\":\"compute\",\"function\":\"supportPlayground\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}},{\"kind\":\"compute\",\"function\":\"collidePlayground\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}},{\"kind\":\"compute\",\"function\":\"solvePlayground\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}},{\"kind\":\"compute\",\"function\":\"collidePlayground\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}},{\"kind\":\"compute\",\"function\":\"solvePlayground\",\"threads\":[1],\"buffers\":{\"1\":\"game\"}}],\"present\":[{\"kind\":\"render\",\"vertex\":\"fullscreenVertex\",\"fragment\":\"playgroundFragment\",\"target\":\"display\",\"load\":\"clear\",\"vertexCount\":3,\"fragmentBuffers\":{\"1\":\"game\"}}],\"swaps\":[],\"output\":\"display\"}"
      },
      "resources": {},
      "title": "Playground state and GPU passes"
    },
    {
      "executionState": "enabled",
      "id": "trackpad",
      "kind": "input.trackpad",
      "parameters": {
        "x": {
          "$type": "number",
          "value": 0.5
        },
        "y": {
          "$type": "number",
          "value": 0.5
        },
        "spaceAction": "secondary"
      },
      "resources": {},
      "title": "Look · click shoots · Space fires a cannonball"
    },
    {
      "executionState": "enabled",
      "id": "direction-pad",
      "kind": "input.directionPad",
      "parameters": {},
      "resources": {},
      "title": "WASD movement · R rebuilds"
    }
  ],
