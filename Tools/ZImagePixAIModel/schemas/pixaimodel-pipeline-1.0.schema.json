{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixeltje.app/schemas/pixaimodel/pipeline/1.0",
  "title": "Pixeltje declarative generation pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "minimumRuntime", "modes", "parameters", "nodes", "edges", "outputs"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/semver"},
    "minimumRuntime": {"$ref": "#/$defs/semver"},
    "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["text-to-image", "image-to-image", "inpaint", "outpaint"]}},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "type", "required"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "type": {"enum": ["string", "integer", "number", "boolean"]},
          "required": {"type": "boolean"},
          "default": {}, "minimum": {"type": "number"}, "maximum": {"type": "number"},
          "multipleOf": {"type": "number", "exclusiveMinimum": 0},
          "enum": {"type": "array", "minItems": 1, "uniqueItems": true}
        }
      }
    },
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "operation", "inputs", "outputs", "configuration"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "operation": {"$ref": "#/$defs/operation"},
          "inputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "outputs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "configuration": {
            "type": "object",
            "properties": {
              "resource": {"$ref": "#/$defs/relativePath"},
              "resourceDirectory": {"$ref": "#/$defs/relativePath"},
              "schedulerConfiguration": {"$ref": "#/$defs/relativePath"}
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": {"$ref": "#/$defs/endpoint"},
          "to": {"$ref": "#/$defs/endpoint"}
        }
      }
    },
    "outputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "semantic"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "source": {"$ref": "#/$defs/endpoint"},
          "semantic": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"},
    "endpoint": {"type": "string", "pattern": "^(?:parameter|node):[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)?$"},
    "operation": {
      "enum": [
        "chat-template", "tokenize", "seeded-noise", "core-ai", "tensor-reshape",
        "tensor-pack", "tensor-patchify", "tensor-unpatchify", "tensor-slice",
        "tensor-concatenate", "rope", "flow-match-euler-loop", "vae-affine",
        "normalize", "tiled-execution", "source-prepare", "mask-prepare",
        "masked-latent-compose", "preview-output", "final-output"
      ]
    }
  }
}
