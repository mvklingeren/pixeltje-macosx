      "kind": "primitive.string",
      "parameters": {
        "value": "{\"version\":1,\"parameters\":[\"trail\",\"sparkle\",\"orbitSpeed\",\"nebula\",\"travelSpeed\"],\"resources\":[{\"name\":\"history\",\"kind\":\"texture\"},{\"name\":\"historyNext\",\"kind\":\"texture\"},{\"name\":\"display\",\"kind\":\"texture\"}],\"initialize\":[],\"tick\":[{\"kind\":\"render\",\"vertex\":\"fullscreenVertex\",\"fragment\":\"fadeFragment\",\"target\":\"historyNext\",\"load\":\"clear\",\"vertexCount\":3,\"fragmentTextures\":{\"1\":\"history\"}},{\"kind\":\"render\",\"vertex\":\"fullscreenVertex\",\"fragment\":\"bloomFragment\",\"target\":\"historyNext\",\"load\":\"load\",\"blend\":\"additive\",\"vertexCount\":3},{\"kind\":\"render\",\"vertex\":\"orbitVertex\",\"fragment\":\"orbitFragment\",\"target\":\"historyNext\",\"load\":\"load\",\"blend\":\"additive\",\"vertexCount\":6,\"instanceCount\":3072}],\"swaps\":[[\"history\",\"historyNext\"]],\"present\":[{\"kind\":\"render\",\"vertex\":\"fullscreenVertex\",\"fragment\":\"presentFragment\",\"target\":\"display\",\"load\":\"clear\",\"vertexCount\":3,\"fragmentTextures\":{\"1\":\"history\"}}],\"output\":\"display\"}"
