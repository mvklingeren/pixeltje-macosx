      "input": {
        "nodeID": "render",
        "port": "sourceFile"
      },
      "output": {
        "nodeID": "shader-text",
        "port": "value"
      }
    }
  ],
  "controlConnections": [
    {
      "id": "output.completed->loop.completed",
